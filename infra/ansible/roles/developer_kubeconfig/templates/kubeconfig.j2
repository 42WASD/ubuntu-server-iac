# Generic developer kubeconfig — rendered by the `developer_kubeconfig`
# Ansible role (Phase 27, Dex OIDC via kubelogin device-code flow).
#
# Content is identical for every developer except the context/user NAME
# ({{ developer_kubeconfig_user }}), which is cosmetic. The real identity is
# resolved by kubelogin under each OS user's home. The Dex `kubernetes` client
# is PUBLIC (device-code grant), so there is NO client secret here.
apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: {{ developer_kubeconfig_ca_data }}
    server: {{ developer_kubeconfig_server }}
  name: {{ developer_kubeconfig_cluster_name }}
contexts:
# Primary context: the tenant's default dev namespace. Uses the exec
# credential user so device-code auth works out of the box.
- context:
    cluster: {{ developer_kubeconfig_cluster_name }}
    user: {{ developer_kubeconfig_user }}
    namespace: {{ developer_kubeconfig_namespace }}
  name: {{ developer_kubeconfig_user }}
{% for ctx in developer_kubeconfig_contexts %}
# Pre-configured tenant context {{ developer_kubeconfig_cluster_name }}-{{ ctx.name }}
# -> namespace {{ ctx.namespace }}. All contexts reuse the SAME exec user
# ({{ developer_kubeconfig_user }}); only the default namespace changes. This
# lets developers `kubectl config use-context <name>` to target a tenant
# namespace without ever creating a context with an empty `user:` (which would
# fall back to a basic-auth "Please enter Username" prompt).
- context:
    cluster: {{ developer_kubeconfig_cluster_name }}
    user: {{ developer_kubeconfig_user }}
    namespace: {{ ctx.namespace }}
  name: {{ developer_kubeconfig_cluster_name }}-{{ ctx.name }}
{% endfor %}
current-context: {{ developer_kubeconfig_user }}
kind: Config
users:
- name: {{ developer_kubeconfig_user }}
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      args:
      - oidc-login
      - get-token
      - --grant-type=device-code
      - --oidc-issuer-url={{ developer_kubeconfig_issuer_url }}
      - --oidc-client-id={{ developer_kubeconfig_client_id }}
{% for scope in developer_kubeconfig_extra_scopes %}      - --oidc-extra-scope={{ scope }}
{% endfor %}      command: kubectl
      interactiveMode: IfAvailable
      provideClusterInfo: true