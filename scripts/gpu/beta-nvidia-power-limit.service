# GPU power limiter service (beta host)
# Sets persistence mode and the minimum supported power limit on the
# NVIDIA GPUs of host `beta` (192.168.8.135).
# Power limits reset on driver reload/reboot, so this enforces them at boot.
#
# GPU inventory on beta:
#   GPU 0 (0000:07:00.0): GeForce GTX 1070   -> min supported power limit = 75W
#   GPU 1 (0000:06:00.0): GeForce RTX 3070 Mobile -> currently fails
#       RmInitAdapter (0x62:0x55), so no power limit can be applied.
#       Revisit once the GPU initializes.
#
# Install:
#   sudo cp scripts/gpu/beta-nvidia-power-limit.service /etc/systemd/system/nvidia-power-limit.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nvidia-power-limit.service
#
# Verify:
#   nvidia-smi --query-gpu=index,name,power.limit,persistence_mode --format=csv
[Unit]
Description=Set NVIDIA GPU power limits to minimum supported and enable persistence mode (beta)
After=multi-user.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# Persistence mode keeps the driver loaded so power limits stay applied.
ExecStart=/usr/bin/nvidia-smi -pm 1
# Apply the lowest supported power limit to the GTX 1070.
ExecStart=/usr/bin/nvidia-smi -i 0 -pl 75

[Install]
WantedBy=multi-user.target